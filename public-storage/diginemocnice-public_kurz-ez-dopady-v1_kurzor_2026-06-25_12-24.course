    {
      "id": "x16_gjjt1a",
      "ts": 1782381307310,
      "label": "Elektronizace zdravotnictví (a její dopady) pro středně pokročilé",
      "data": {
        "name": "Elektronizace zdravotnictví (a její dopady) pro středně pokročilé",
        "short": "cz.diginemocnice.ez-dopady",
        "idnumber": "cz.040.20300001627",
        "category": "Zdravotnictví",
        "format": "topics",
        "lang": "cs",
        "summary": "",
        "startdate": "",
        "enddate": "",
        "visible": true,
        "tags": "ezdravotnictví, ehealth, zdravotnictví, digitalizace, nemocnice, poskytovatelé,",
        "maxupload": 0,
        "completion": true,
        "author": "",
        "version": "",
